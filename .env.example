# StreamFinder — environment variables
#
# All keys are read SERVER-SIDE only (never shipped to the client).
# The aggregator falls through providers in order: TMDB → OMDb → local mock.
# Missing keys are OK — the layer is simply skipped and the next one is tried.

# --- TMDB (primary source, includes JustWatch watch/providers) ---
# Get one at https://www.themoviedb.org/settings/api
# Use ONE of the two:
TMDB_API_KEY=
# OR the v4 read-access token (preferred):
TMDB_READ_TOKEN=

# --- OMDb (fallback for metadata when TMDB is unavailable) ---
# Get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Public site URL (used for canonical, OG, sitemap, robots) ---
NEXT_PUBLIC_SITE_URL=https://streamfinder.app
